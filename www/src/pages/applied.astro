---
import GlobalLayout from "../layouts/global.astro";
import Scribble from "../components/Scribble.astro";
---

<GlobalLayout>
	<!-- bg video -->
	<video
		id="bg-video"
		class="fixed inset-0 w-full h-full object-cover object-center -z-30 pointer-events-none blur-[3px]"
		src="/unfold-bg.mp4"
		autoplay
		preload="auto"
		loop
		muted
		playsinline></video>

	<!-- darken overlay -->
	<div class="fixed inset-0 -z-20 bg-black/90 pointer-events-none"></div>

	<!-- noise/grain overlay -->
	<div
		class="fixed inset-0 -z-10 pointer-events-none mix-blend-overlay bg-repeat bg-[length:250px_250px] animate-[grain_0.5s_steps(10)_infinite]"
		style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.45' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;);"
	>
	</div>

	<!-- scribble canvas -->
	<Scribble />

	<main
		class="fixed inset-0 flex flex-col items-center justify-center px-8 text-center"
	>
		<p
			class="text-white/70 font-serif text-base md:text-lg tracking-[0.3em] mb-10 uppercase"
		>
			you're in
		</p>

		<p
			class="text-white font-serif text-2xl md:text-3xl max-w-xl leading-relaxed"
		>
			welcome to unfold. check the slack — we just added you to the
			channels. see you in june.
		</p>

		<p
			class="text-white/40 font-serif text-sm md:text-base tracking-[0.2em] mt-16 max-w-md"
		>
			ꕥ
		</p>

		<a
			href="/"
			class="text-white/30 hover:text-white/60 font-serif text-xs tracking-[0.3em] uppercase mt-24 transition-colors duration-300"
		>
			← back home
		</a>
	</main>
</GlobalLayout>
